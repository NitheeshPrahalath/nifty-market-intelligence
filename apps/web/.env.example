# Origin of the Phase 7 API that the Next server proxies to. Server-side only;
# the browser always calls the dashboard's own origin.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: point the browser straight at the API instead of using the proxy
# (requires CORS on the API). Leave unset for local development.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
