# --- Database ---
DATABASE_URL=postgresql+psycopg2://nmi:nmi@localhost:5432/nmi
DB_ECHO=false

# --- Logging ---
LOG_LEVEL=INFO

# --- Ingestion: provider selection ---
PRICE_PROVIDER=csv
FUNDAMENTAL_PROVIDER=csv
CORPORATE_ACTION_PROVIDER=csv
INDEX_MEMBERSHIP_PROVIDER=csv

# --- Ingestion: local data directories (csv provider) ---
DATA_DIR=./data/raw
MEMBERSHIP_DIR=./data/raw/memberships
CORPORATE_ACTIONS_DIR=./data/raw/corporate_actions
FUNDAMENTALS_DIR=./data/raw/fundamentals

# --- Ingestion: validation tuning ---
VALIDATION_OUTLIER_ZSCORE=8
VALIDATION_MAX_GAP_BUSINESS_DAYS=5

# --- API (Phase 7) ---
API_TITLE=Nifty Market Intelligence API
API_VERSION=v1
API_PREFIX=/api/v1
# Set to true to require an API key (X-API-Key or Authorization: Bearer).
API_AUTH_ENABLED=false
# Comma/JSON list of accepted keys when auth is enabled, e.g. ["key-one","key-two"].
API_KEYS=[]
# Requests per minute per principal; 0 disables limiting.
API_RATE_LIMIT_PER_MINUTE=120
# Response cache TTL in seconds; 0 disables caching.
API_CACHE_TTL_SECONDS=60
API_AUDIT_ENABLED=true
API_AUDIT_RETENTION_DAYS=90
# Optional Redis for a shared cache/limiter; in-memory is used when unset.
# REDIS_URL=redis://localhost:6379/0

# --- AI explanations (Phase 9) ---
# "template" (default) renders deterministic, fully-cited prose with no network.
# Any other value (e.g. "openai") uses an OpenAI-compatible chat endpoint and
# falls back to the template provider if the response fails citation checks.
EXPLAIN_PROVIDER=template
EXPLAIN_MODEL=gpt-4o-mini
# OpenAI, or Gemini's OpenAI-compatible endpoint, or a local Ollama server.
EXPLAIN_BASE_URL=https://api.openai.com/v1
# Required only for hosted providers; Ollama ignores it.
# EXPLAIN_API_KEY=sk-...
EXPLAIN_TIMEOUT_SECONDS=30
EXPLAIN_MAX_TOKENS=800
EXPLAIN_TEMPERATURE=0.2
